# ==============================================================================
# PromptBridge RAG Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials and keys.
# DO NOT commit your .env file to version control (git).

# ------------------------------------------------------------------------------
# 1. LLM API KEYS (Prompt Generation & Synthetic Pair Creation)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Used in generate_pairs.py for synthetic query-doc pairs)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (used by PromptBridge generation and synthetic-pair creation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic Claude API Key (Alternative for pair generation)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (For embeddings, synthetic data, or evaluation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face Access Token (For downloading gated models or pushing datasets)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Cohere API Key (Optional: for RAG reranking)
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here


# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 OBJECT STORAGE (Recommended - S3-compatible, zero egress fees)
# ------------------------------------------------------------------------------
# Where to find these in Cloudflare:
# 1. Log into https://dash.cloudflare.com
# 2. Left sidebar -> R2 Object Storage
# 3. Account ID is shown on the R2 Overview page or in URL: dash.cloudflare.com/<ACCOUNT_ID>/r2
# 4. Click "Manage R2 API Tokens" -> "Create API Token" -> Permissions: Object Read & Write
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=promptbridge-data


# ------------------------------------------------------------------------------
# 3. AWS S3 STORAGE (Optional alternative to Cloudflare R2)
# ------------------------------------------------------------------------------
# Used when --s3_bucket argument is passed to scrapers or pipeline
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name


# ------------------------------------------------------------------------------
# 4. DATA PIPELINE SETTINGS (Defaults for Scraping, Chunking & Ingestion)
# ------------------------------------------------------------------------------
OUTPUT_DIR=./data
RAW_DOCS_DIR=./data/raw_docs
TRAINING_PAIRS_DIR=./data/training_pairs

# Chunking & Pairing Parameters
CHUNK_TOKENS=400
OVERLAP_TOKENS=60
PAIRS_PER_CHUNK=3
MAX_CHUNKS_PER_DOC=15
